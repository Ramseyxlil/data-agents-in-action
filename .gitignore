# ------------------------------------------------------------------
# Secrets
# ------------------------------------------------------------------

# Your real API keys live in .env. Never commit it. The .env.example
# file has no secrets, so it stays in git as a template.
.env
!.env.example

# ------------------------------------------------------------------
# Generated data
# ------------------------------------------------------------------

# The Kora database is built on your machine by a seeded script, so it
# never needs to be committed. Keep the empty folder, though.
data/*
!data/.gitkeep

# DuckDB and Parquet files are generated data, wherever they end up.
*.duckdb
*.duckdb.wal
*.parquet

# break_it.py saves every run in a chapter's results/ folder. Those
# are your results, not the book's code, so only the empty folder is
# kept.
ch*/*/results/*
!ch*/end/results/.gitkeep

# ------------------------------------------------------------------
# Zipped and archived files
# ------------------------------------------------------------------

# Bundles made for sharing (a chapter sent to a reviewer, a backup).
# The repo holds the real files, so the bundles stay out.
*.zip
*.7z
*.rar
*.tar
*.gz
*.tgz
*.bz2
*.xz

# ------------------------------------------------------------------
# Python
# ------------------------------------------------------------------

# Build output and caches. They are rebuilt on every run, so there is
# nothing worth keeping.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Virtual environments. Each reader makes their own.
.venv/
venv/
env/

# ------------------------------------------------------------------
# Editors and operating systems
# ------------------------------------------------------------------

# Editor settings are personal, so they stay out of the shared repo.
.vscode/
.idea/

# Files the operating system drops into folders on its own.
.DS_Store
Thumbs.db
