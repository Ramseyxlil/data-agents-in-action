# Which model provider the agent talks to: openai, anthropic or azure.
# Chapter 2 supports openai and anthropic.
MODEL_PROVIDER=openai

# OpenAI settings. Fill these in only if MODEL_PROVIDER=openai.
# OPENAI_MODEL is any chat model your account can call, for example
# OPENAI_MODEL=gpt-4.1
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic settings. Fill these in only if MODEL_PROVIDER=anthropic.
# ANTHROPIC_MODEL is a model ID from Anthropic's model list.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Azure-hosted model settings. Fill these in only if MODEL_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Where the Kora database is written on your machine.
KORA_DB_PATH=data/kora.duckdb
